# ==============================================================================
# API NEURAL NETWORK - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# The application works 100% offline and keyless using the built-in
# Semantic Feature Extractor (384-d) and Grounded Retrieval LLM Synthesizer.
#
# Optional: Provide API keys below if you wish to connect external LLM providers.
# DO NOT COMMIT REAL SECRETS OR KEYS TO SOURCE CONTROL.
# ==============================================================================

# Google Gemini API Key (optional)
# https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# OpenAI API Key (optional)
# https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Local Ollama Endpoint (optional, defaults to http://localhost:11434)
# https://ollama.ai/
VITE_OLLAMA_ENDPOINT=http://localhost:11434

